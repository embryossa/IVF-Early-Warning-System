**/run_manifest.json
**/calibration_manifest.json
**/ews_charts_state.json
*.html
!docs/**/*.html

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Прочее ----------------------------------------------------------------
.DS_Store
Thumbs.db

# Сгенерированные пороги калибровки: привязаны к объёму конкретной лаборатории,
# переезжать вместе с репозиторием НЕ должны (docs/PORTING.md §4).
config/thresholds.*.local.yaml

# --- Вендоренная модель конверта -------------------------------------------
# Веса (233 МБ) и обучающая когорта (данные пациенток) едут вместе с ПАПКОЙ
# проекта, а не через git. Единица переноса — каталог, не `git clone`.
external/tabpfn/models/*.ckpt
external/tabpfn/models/*.metadata
external/tabpfn/.venv/
external/tabpfn/tabpfn3_report_cache/
# Побочные артефакты скрипта модели: он пишет свой HTML/XLSX рядом с собой.
external/tabpfn/ivf_tabpfn3_*.html
external/tabpfn/opu_tabpfn3_*.xlsx
external/tabpfn/opu_tabpfn3_*.csv

# --- Рабочие заметки, не документация проекта ------------------------------
# Исходное задание содержит абсолютные пути машины, ссылку на мастер-таблицу и
# структуру соседних проектов. Как история решений оно ценно, но в репозитории
# ему не место: пути машинозависимы, а ссылка на лист — идентификатор.
task.md
data/**/_*.txt
